  - {fileID: 32900000, guid: d55c2846e7d080e44a6a40cb4169a9aa, type: 3}
  - {fileID: 32900000, guid: 4a6626192003d8f47b5c5d327a53dd95, type: 3}
  descriptions:
  - "\u0414\u043B\u044F \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u043A\u0430\u043C\u0435\u0440\u044B
    \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0439\u0442\u0435 \u043C\u044B\u0448\u044C"
  - "\u0414\u043B\u044F \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043A\u043B\u0430\u0432\u0438\u0448\u0438
    w/a/s/d"
  - "\u0414\u043B\u044F \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043A\u043B\u0430\u0432\u0438\u0448\u0443
    \u0415"
  - "\u0414\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0444\u043E\u043D\u0430\u0440\u0438\u043A\u0430 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \u041B\u041A\u041C"
  - "\u0412\u0441\u0451, \u0447\u0442\u043E \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u043F\u0435\u0440\u0432\u043E\u0439 \u0441\u0446\u0435\u043D\u044B
    \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044F. \u0417\u0432\u0443\u043A\u0438,
    \u0432\u0438\u0434 \u0437\u0430 \u043E\u043A\u043D\u043E\u043C, \u043C\u0435\u043B\u043A\u0438\u0435
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F."
  - "\u0426\u0435\u043B\u044C \u0438\u0433\u0440\u044B \u043D\u0430\u0439\u0442\u0438
    \u0432\u0441\u0435 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0438 \u043D\u0430
    10 \u0441\u0446\u0435\u043D\u0430\u0445"
