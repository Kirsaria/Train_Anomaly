--- !u!114 &1767300544
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1767300538}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a38e5bf2b7abd154a9736b09d29394af, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  stories:
  - <Tag>k__BackingField: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439"
    <Text>k__BackingField: "\u041D\u0443, \u0447\u0442\u043E? \u0422\u0435\u0431\u0435
      \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C \u043C\u043E\u0438
      \u0438\u0433\u0440\u044B?"
    <Answers>k__BackingField:
    - <Text>k__BackingField: "\u0422\u044B \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u0442\u0443\u0442\u0443...?"
      <ReposeText>k__BackingField: "\u041E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u0435"
    - <Text>k__BackingField: "\u0425\u043E\u0447\u0443 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
      <ReposeText>k__BackingField: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0435"
    - <Text>k__BackingField: "\u0421 \u043C\u0435\u043D\u044F \u0445\u0432\u0430\u0442\u0438\u0442"
      <ReposeText>k__BackingField: "\u041E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u0435"
  - <Tag>k__BackingField: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0435"
    <Text>k__BackingField: "\u0422\u0430\u043A \u0438 \u0437\u043D\u0430\u043B, \u0447\u0442\u043E
      \u0442\u044B \u043A\u0440\u0435\u043F\u043A\u0438\u0439 \u043E\u0440\u0435\u0448\u0435\u043A,
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438 \u0434\u0430\u043B\u044C\u0448\u0435.
      \u0412\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F \u0441\u043D\u043E\u0432\u0430
      \u0447\u0435\u0440\u0435\u0437 10 \u0432\u0430\u0433\u043E\u043D\u043E\u0432!"
    <Answers>k__BackingField: []
  - <Tag>k__BackingField: "\u041E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u0435"
    <Text>k__BackingField: "\u0425\u0430\u0445\u0430\u0445\u0430\u0445\u0430, \u0432\u0435\u0441\u0435\u043B\u043E
      - \u0432\u0435\u0441\u0435\u043B\u043E"
    <Answers>k__BackingField:
    - <Text>k__BackingField: "\u0413\u0434\u0435 \u044F \u0432\u043E\u043E\u0431\u0449\u0435?
        \u0418 \u0447\u0442\u043E \u0442\u044B \u0442\u0430\u043A\u043E\u0435?"
      <ReposeText>k__BackingField: "\u0414\u0438\u0430\u043B\u043E\u0433 2"
  - <Tag>k__BackingField: "\u0414\u0438\u0430\u043B\u043E\u0433 2"
    <Text>k__BackingField: "\u042F \u044D\u0442\u043E \u0442\u044B, \u0442\u043E\u0447\u043D\u0435\u0435
      \u0442\u0432\u043E\u0451 \u0431\u043E\u043B\u044C\u043D\u043E\u0435 \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435."
    <Answers>k__BackingField:
    - <Text>k__BackingField: "\u0418 \u043A\u0430\u043A \u044D\u0442\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C?"
      <ReposeText>k__BackingField: "\u0414\u0438\u0430\u043B\u043E\u0433 3"
    - <Text>k__BackingField: "\u0427\u0442\u043E \u0437\u0430 \u0431\u0440\u0435\u0434!?"
      <ReposeText>k__BackingField: "\u0414\u0438\u0430\u043B\u043E\u0433 3"
  - <Tag>k__BackingField: "\u0414\u0438\u0430\u043B\u043E\u0433 3"
    <Text>k__BackingField: "\u042F \u0432 \u0442\u0432\u043E\u0435\u0439 \u0433\u043E\u043B\u043E\u0432\u0435."
    <Answers>k__BackingField:
    - <Text>k__BackingField: ?????
      <ReposeText>k__BackingField: "\u0414\u0438\u0430\u043B\u043E\u0433 4"
  - <Tag>k__BackingField: "\u0414\u0438\u0430\u043B\u043E\u0433 4"
    <Text>k__BackingField: "\u0421\u043E\u0432\u0441\u0435\u043C \u0442\u0443\u0433\u043E
      \u0441\u043E\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0448\u044C...\u043B\u0430\u0434\u043D\u043E.
      \u042D\u0442\u043E \u0432\u0441\u0435 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u043E
      \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0439 \u0441\u043E\u043D
      \u0442\u0432\u043E\u0435\u0433\u043E \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u044F."
    <Answers>k__BackingField:
    - <Text>k__BackingField: "\u041F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F
        \u0442\u044B \u0438 \u0435\u0441\u0442\u044C \u043C\u043E\u0451 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435?"
      <ReposeText>k__BackingField: "\u0414\u0438\u0430\u043B\u043E\u0433 5"
    - <Text>k__BackingField: "\u0410 \u0442\u044B \u0442\u0443\u0442 \u043F\u0440\u0438
        \u0447\u0435\u043C?"
      <ReposeText>k__BackingField: "\u0422\u0443\u043F\u0438\u0442"
  - <Tag>k__BackingField: "\u0422\u0443\u043F\u0438\u0442"
    <Text>k__BackingField: "\u042F \u0418 \u0415\u0421\u0422\u042C \u0422\u0412\u041E\u0401
      \u0421\u041E\u0417\u041D\u0410\u041D\u0418\u0415!!!"
    <Answers>k__BackingField:
    - <Text>k__BackingField: "\u0422\u044B?"
      <ReposeText>k__BackingField: "\u0414\u0438\u0430\u043B\u043E\u0433 5"
  - <Tag>k__BackingField: "\u0414\u0438\u0430\u043B\u043E\u0433 5"
    <Text>k__BackingField: "\u0414\u0430. \u041C\u044B \u0441 \u0442\u043E\u0431\u043E\u0439
      \u0441\u0432\u044F\u0437\u0430\u043D\u044B, \u043D\u043E \u0442\u044B \u044D\u0442\u043E\u0433\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u043E\u0441\u043E\u0437\u043D\u0430\u0435\u0448\u044C.
      \u041D\u0430 \u0442\u0432\u043E\u0451\u043C \u043C\u0435\u0441\u0442\u0435
      \u044F \u043E\u0441\u043E\u0431\u043E \u0431\u044B \u043D\u0435 \u0437\u0430\u043C\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u043B\u0441\u044F.
      \u0412\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u0442\u044B \u043D\u0435
      \u043F\u0440\u043E\u0441\u043D\u0435\u0448\u044C\u0441\u044F."
    <Answers>k__BackingField: []
